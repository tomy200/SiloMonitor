<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== RECURSOS NATIVOS ===================== -->
    <!-- Cámara: se solicita en tiempo de ejecución antes de tomar la foto (Guía 13). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Vibración: permiso normal, se otorga al instalar. Se usa como feedback háptico. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notificaciones: en Android 13+ se solicita en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Galería: se usa ActivityResultContracts.GetContent(), que abre el selector del sistema
        y entrega acceso solo a la imagen elegida. Por eso NO se pide READ_MEDIA_IMAGES
        (principio de mínimo privilegio).
    -->

    <application
        android:name=".SiloMonitorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiloMonitor"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SiloMonitor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider: entrega a la app de cámara una Uri segura donde guardar la foto. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Necesario en Android 11+ para poder lanzar la app de cámara del sistema. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

</manifest>
